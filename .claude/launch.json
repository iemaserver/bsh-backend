{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Dev Server (nodemon)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "Production Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "Prisma Studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "db:studio"],
      "port": 5555
    }
  ]
}
