{
    "name": "iem-bsh-backend",
    "version": "1.0.0",
    "description": "IEM BSH Department Website Backend API",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "dev": "nodemon src/server.js",
        "start": "node src/server.js",
        "seed": "node prisma/seed.js",
        "reset-admin": "node scripts/reset-admin.js",
        "db:push": "npx prisma db push",
        "db:generate": "npx prisma generate",
        "db:studio": "npx prisma studio",
        "migrate:deploy": "prisma migrate deploy",
        "pm2:start": "pm2 start ecosystem.config.cjs",
        "pm2:reload": "pm2 reload ecosystem.config.cjs",
        "pm2:logs": "pm2 logs iem-bsh-api",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@prisma/client": "^5.9.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "nodemailer": "^8.0.5"
    },
    "devDependencies": {
        "nodemon": "^3.0.2",
        "prisma": "^5.9.0"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    }
}
