# ========================
# SERVER
# ========================
PORT=6500

# ========================
# JWT AUTH
# ========================
# Use a long, random string in production
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
# Token expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================
# ADMIN SEED CREDENTIALS
# Used only when running: npm run seed
# ========================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# ========================
# CORS
# Comma-separated list of allowed origins, or * to allow all
# ========================
CORS_ORIGINS=https://your-frontend.vercel.app

# ========================
# DATABASE
# For local development (Homebrew/Docker Postgres):
#   Both URLs are identical — no pgbouncer pooling needed locally.
#   DATABASE_URL  → used at runtime
#   DIRECT_URL    → used for prisma db push / migrations (can match DATABASE_URL locally)
# ========================
DATABASE_URL="postgresql://YOUR_SYSTEM_USER@localhost:5432/iem_bsh"
DIRECT_URL="postgresql://YOUR_SYSTEM_USER@localhost:5432/iem_bsh"

# For production (Supabase or similar managed Postgres with pgbouncer):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ========================
# EMAIL (Gmail SMTP)
# Use a Gmail App Password — NOT your account password
# Generate one at: https://myaccount.google.com/apppasswords (requires 2FA)
# If omitted, email notifications are silently disabled
# ========================
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# Primary recipient for login alerts and password change notifications
ADMIN_EMAIL=primary_admin@example.com
# Optional secondary CC recipient
ADMIN_EMAIL2=secondary_admin@example.com
